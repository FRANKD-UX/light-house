{
  "name": "light-house-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && node --test .build/tests/*.test.js",
    "auth": "npm run build && node .build/src/cli.js auth",
    "development": "npm run build && node .build/src/cli.js run",
    "headed": "npm run build && node .build/src/cli.js run --headed",
    "report": "npm run build && node .build/src/cli.js report",
    "test:fixture": "npm run build && node .build/tests/browser.fixture.js",
    "doctor": "npm run build && node .build/src/cli.js doctor"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
