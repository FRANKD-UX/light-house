{
  "name": "light-house",
  "version": "0.1.0",
  "private": true,
  "description": "Light House \u2014 ISP incident orchestration foundation",
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "npm run typecheck && vite build && vite build --config vite.issue-context.config.ts && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --external:@forge/resolver --external:@forge/sql --external:@forge/api --external:@forge/events --external:@forge/kvs --outfile=dist/backend/index.cjs",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run check:manifest",
    "check:manifest": "node scripts/check-manifest.mjs",
    "test:e2e:auth": "npm --prefix e2e run auth",
    "test:e2e:development": "npm --prefix e2e run development",
    "test:e2e:development:headed": "npm --prefix e2e run headed",
    "test:e2e:report": "npm --prefix e2e run report",
    "test:e2e:check": "npm --prefix e2e run check",
    "test:e2e:fixture": "npm --prefix e2e run test:fixture",
    "test:e2e:doctor": "npm --prefix e2e run doctor",
    "test:webhook:dry-run": "node scripts/webhook-acceptance.mjs --dry-run"
  },
  "dependencies": {
    "@forge/api": "8.5.1",
    "@forge/bridge": "7.4.0",
    "@forge/events": "3.0.11",
    "@forge/kvs": "2.1.3",
    "@forge/resolver": "2.0.2",
    "@forge/sql": "4.0.11",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}
